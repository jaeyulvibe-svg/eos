{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/notices.js": { "maxDuration": 30 }
  },
  "crons": [
    {
      "path": "/api/notices?refresh=daily",
      "schedule": "0 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
